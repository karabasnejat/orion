; Orion / Kül Yemini — Godot 4.5.1
config_version=5

[application]
config/name="Kül Yemini — Orion"
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="Phase 1 combat prototype"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.025, 0.03, 0.06, 1)

[physics]
common/physics_ticks_per_second=60
2d/default_gravity=1200.0

[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="OneWayPlatform"
